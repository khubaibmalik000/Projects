# Copy to /etc/default/aiops-node-agent and fill in real values.

# Base URL of the running AIOps API.
AIOPS_API_BASE_URL=http://aiops-api.internal:8000

# Required: the name this node/service reports as. Use the same name in
# AIOPS_AGENT_TOPOLOGY_EDGES on other agents when wiring up dependencies.
AIOPS_AGENT_ENTITY=orders-api-node-1

# How often to collect and send metrics, in seconds.
AIOPS_AGENT_INTERVAL_SECONDS=15

# Optional: a log file to tail and forward new lines from.
AIOPS_AGENT_LOG_FILE=/var/log/myapp/app.log

# Optional: register service-dependency edges on startup, format
# "upstream:downstream,upstream:downstream". Only needs to be set on one
# agent per edge -- it's additive across all agents that set it.
AIOPS_AGENT_TOPOLOGY_EDGES=db-primary:orders-api,orders-api:checkout-web

AIOPS_AGENT_LOG_LEVEL=INFO
